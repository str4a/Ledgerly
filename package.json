{
  "name": "ledgerly",
  "version": "1.4.2",
  "description": "Ledgerly trading journal desktop application",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win nsis portable",
    "update-server": "node desktop/update-server.js",
    "test": "node --test test/*.test.js",
    "icons": "node desktop/create-icon.js"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.ledgerly.app",
    "productName": "Ledgerly",
    "files": [
      "Ledgerly-live.html",
      "ledgerly-live.css",
      "src/**/*",
      "marketstack-api.js",
      "ledgerly.webmanifest",
      "ledgerly-app-icon-v2-192.png",
      "ledgerly-app-icon-v2-512.png",
      "Ledgerly Golden Orbit Logo.png",
      "desktop/**/*",
      "version.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "str4a",
      "repo": "Ledgerly",
      "private": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
